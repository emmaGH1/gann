# Copy to cloudflare-secrets.env, replace every placeholder locally, and never commit/share the filled file.
# Values are raw (no wrapping quotes). This file is for `wrangler secret bulk` only.
GANN_BROKER_KEY=REPLACE_WITH_RANDOM_64_HEX_CHAR_KEY
UPSTASH_REDIS_REST_URL=REPLACE_WITH_RAW_HTTPS_REST_URL
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_UPSTASH_REST_TOKEN
